PORT=5000

# Path to the Firebase service account private key JSON
# Download it from: Firebase Console > Project Settings > Service accounts > Generate new private key
# Save it in this folder as serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Allow frontends to call this API (your Vite dev servers + deployed frontend).
# Use * for any origin (easiest while testing). For production, list exact origins.
FRONTEND_ORIGIN=*

# ---- Admin panel ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret used to sign admin session tokens. Change to any long random string.
ADMIN_TOKEN_SECRET=

# ---- Email (SMTP) ----
# Gmail / Google SMTP using a Google App Password (NOT your normal Gmail password).
# App password setup: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OTP_FROM_EMAIL=

# Secret used to HMAC-hash OTP codes before storing them in Firestore.
# Change this to any long random string.
OTP_HASH_SECRET=

# ---- SMS (Africa's Talking) ----
# Optional. When empty, customers are only notified by email.
# Get a key at https://account.africastalking.com
AT_API_KEY=
AT_USERNAME=sandbox
# Optional registered alphanumeric sender ID
AT_SENDER_ID=
